  "suite": "node",
  "workload": {
    "name": "TypeScript: opencode",
    "description": "Cold clone, bun install and typecheck of anomalyco/opencode, at the commit and Bun version ComputeSDK's DAX sandbox benchmark uses. Unlike DAX, typecheck runs `turbo typecheck --concurrency=4` on every runner, whatever its size: turbo's default parallelism needs more than 16 GB and gets OOM-killed on runners without swap. Totals are therefore not directly comparable with DAX. Turbo's local and remote caches are off (`--cache=local:,remote:`), so a runner with a Turborepo remote cache still typechecks every package.",
    "repository": "https://github.com/anomalyco/opencode",
    "ref": "08fb47373509ba64b13441061314eeacf4264f51",
    "toolchain": "bun 1.3.14, node-gyp 12.4.0 on PATH (native modules built on every runner)",
    "reference": "https://www.computesdk.com/benchmarks/sandboxes/dax",
    "typecheck": "bun turbo typecheck --concurrency=4 --cache=local:,remote:"
  },
