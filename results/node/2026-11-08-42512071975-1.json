    "ref": "08fb47373509ba64b13441061314eeacf4264f51",
    "toolchain": "bun 1.3.14, node-gyp 12.4.0 on PATH (native modules built on every runner)",
    "reference": "https://www.computesdk.com/benchmarks/sandboxes/dax",
    "typecheck": "bun turbo typecheck --concurrency=4 --cache=local:,remote:"
  },
